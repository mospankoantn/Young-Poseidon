/// @description Вимкнення музики меню
/// obj_main_menu_sound — Room End Event

// Встановлюємо гучність на 0 за 2000 мс (2 секунди)
// Замість 'm_main_menu' можна використати ID конкретної копії звуку, збережений у змінну
audio_sound_gain(snd_olympus_overture, 0, 2000);

// Додатково: можна використати Alarm, щоб зупинити звук повністю або змінити кімнату після затухання
//alarm[0] = room_speed * 2; 