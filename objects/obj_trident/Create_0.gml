// Характеристики
damage = 1; // Шкода тризубця
speed = 10; // Швидкість польоту
distance = 150; // Максимальна відстань польоту (якщо потрібно обмежувати і по відстані)
flight_duration_limit = room_speed * 1.5; // Максимальний час польоту в кадрах (1.5 секунди)

// Стан
timer = 0; // Таймер для відліку часу польоту
thrown = false; // Кинутий?
stuck = false; // Застряг?
invisible_time = false; // Чи активний таймер невидимості після підбору

// Координати точки кидка (оновлюються гравцем)
destination_x = x; 
destination_y = y;